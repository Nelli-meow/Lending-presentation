PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Реальная почта ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
